# Server
CRW_PORT=8787
CRW_BIND=0.0.0.0
CRW_PUBLIC_URL=https://codex.example.com
CRW_SESSION_SECRET=replace-with-at-least-32-random-bytes
CRW_LOG_DIR=C:\CodexRemoteWeb\logs
CRW_ADMIN_USER=admin
CRW_ADMIN_PASSWORD=replace-me-on-first-run
CRW_BRIDGE_TOKEN=replace-with-a-different-random-machine-token

# Bridge
CRW_SERVER_URL=https://codex.example.com
CRW_BRIDGE_CONFIG=C:\Users\you\.codex-remote-bridge.json
